---
pagination: { data: site.langs, size: 1, alias: lang }
cle: agir
layout: base.njk
permalink: "{{ site.pages.agir.url[lang] }}"
---
{%- import "partials/composants.njk" as c -%}
{%- set A = agir -%}
{{ c.enteteDePage(A.titre | t(lang), A.intro | t(lang)) }}
<section class="section first">
  <div class="wrap">
    <ul class="actions">
      {%- for a in A.actions %}
      <li>
        <h2>{{ a.titre | t(lang) }}</h2>
        <p>{{ a.texte | t(lang) }}</p>
        <a class="btn btn-ink" href="{{ a.url }}" target="_blank" rel="noopener">{{ a.bouton | t(lang) }}</a>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>
<section class="section">
  <div class="wrap narrow contact">
    <h2>{{ A.rejoindre.titre | t(lang) }}</h2>
    <p>{{ A.rejoindre.texte | t(lang) }}</p>
    {%- for adresse in [site.email, site.emailBureau] %}
    <p class="contact-line"><strong class="email"{% if loop.first %} id="email"{% endif %}>{{ adresse }}</strong>
      <button type="button" class="copy-btn" data-copy="{{ adresse }}" data-done="{{ site.ui.copie | t(lang) }}">{{ site.ui.copier | t(lang) }}</button>
      <span class="copy-status" role="status"></span>
    </p>
    {%- endfor %}
  </div>
</section>
